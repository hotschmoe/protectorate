/home/u/.local
/home/u/.local
--ro-bind
/home/u/.nvm
/home/u/.nvm
--bind
/state/auth/claude
/state/auth/claude
--bind
/work/proj
/work/proj
--chdir
/work/proj
--clearenv
--setenv
HOME
/home/u
--setenv
PATH
/home/u/.local/bin:/usr/bin:/bin
--setenv
