systemd-run
--user
--scope
--quiet
--collect
--unit=prot-sleeve-dave
-p
MemoryMax=1073741824
-p
MemorySwapMax=0
-p
TasksMax=4096
-p
OOMPolicy=continue
--
bwrap
--unshare-pid
--unshare-ipc
--unshare-uts
--die-with-parent
--hostname
dave
--tmpfs
/
--ro-bind
/usr
/usr
--symlink
usr/bin
/bin
--ro-bind
/etc
/etc
--dev
/dev
--proc
/proc
--tmpfs
/tmp
--tmpfs
/var/tmp
--bind
/state/sleeves/dave/home
/home/u
--ro-bind
/home/u/.local
/home/u/.local
--ro-bind
/home/u/.nvm
/home/u/.nvm
--bind
/state/auth/pi
/state/auth/pi
--bind
/work/x
/work/x
--chdir
/work/x
--clearenv
--setenv
HOME
/home/u
--setenv
PATH
/home/u/.local/bin:/usr/bin:/bin
--setenv
PROTECTORATE_SLEEVE_PATH
/home/u/.local/bin:/usr/bin:/bin
--setenv
USER
u
--setenv
LOGNAME
u
--setenv
SHELL
/bin/bash
--setenv
TERM
xterm-256color
--setenv
COLORTERM
truecolor
--setenv
LANG
C.UTF-8
--setenv
PI_CODING_AGENT_DIR
/state/auth/pi
--setenv
PI_CODING_AGENT_SESSION_DIR
/home/u/.pi/sessions
--
/home/u/.local/bin/pi
