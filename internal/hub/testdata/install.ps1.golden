# Installs this machine as a protectorate node. Generated by the hub at
# http://hub.lan:7470; the binary comes from the same hub and is checked against
# its SHA-256 before it runs.
#
#   $env:PROTECTORATE_ENROLL_KEY='KEY'; $env:PROTECTORATE_NODE_NAME='NAME'; irm http://hub.lan:7470/install.ps1 | iex
#
# `irm | iex` cannot pass arguments, so the key and the name come from the
# environment; the name defaults to the hostname. Run it in a normal PowerShell
# (not "Run as administrator") as the user who stays logged in: the agent
# becomes a logon task of that user and runs in their desktop session. Windows
# PowerShell 5.1 and pwsh 7, x64 and ARM64.

# ConvertTo-ProtectorateArch maps a Windows or .NET architecture name to the
# build's, or $null when there is no build for it.
function ConvertTo-ProtectorateArch([string]$Name) {
	switch -Regex ($Name.Trim()) {
		'^arm64$' { return 'arm64' }
		'^(amd64|x64)$' { return 'amd64' }
	}
	return $null
}

# Get-ProtectorateArch returns the machine's own architecture. An x64
# PowerShell emulated on ARM64 sees AMD64 in its environment, so the machine
# environment in the registry and the OS architecture come first.
function Get-ProtectorateArch {
	$names = @()
	try {
		$names += (Get-ItemProperty -LiteralPath 'HKLM:\SYSTEM\CurrentControlSet\Control\Session Manager\Environment' -Name PROCESSOR_ARCHITECTURE).PROCESSOR_ARCHITECTURE
	} catch {}
	try {
		$names += [string][System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture
	} catch {}
	$names += $env:PROCESSOR_ARCHITEW6432
	$names += $env:PROCESSOR_ARCHITECTURE
	foreach ($n in $names) {
		if (-not $n) { continue }
		$a = ConvertTo-ProtectorateArch $n
		if ($a) { return $a }
		throw "Unsupported architecture $n`: builds exist for x64 and ARM64."
	}
	throw 'Could not tell this machine''s architecture.'
}

function Install-ProtectorateNode {
	$ErrorActionPreference = 'Stop'
	$ProgressPreference = 'SilentlyContinue'
	$hub = 'http://hub.lan:7470'
	$control = 'http://10.0.0.5:7480'
	$name = $env:PROTECTORATE_NODE_NAME
	if (-not $env:PROTECTORATE_ENROLL_KEY) {
		throw 'Set the key first: $env:PROTECTORATE_ENROLL_KEY=''KEY'' with the key from Add node in the app.'
	}
	if ($PSVersionTable.PSVersion.Major -ge 6 -and -not $IsWindows) {
		throw 'This installer is for Windows; on Linux and Termux use install.sh.'
	}
	$id = [Security.Principal.WindowsIdentity]::GetCurrent()
	if ((New-Object Security.Principal.WindowsPrincipal $id).IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) {
		throw 'This PowerShell runs as administrator. Open a normal PowerShell (not "Run as administrator") as the user who stays logged in and run the line again: the agent must run in that user''s desktop session.'
	}
	$arch = Get-ProtectorateArch
	$file = "protectorate-windows-$arch.exe"
	$dir = Join-Path $env:LOCALAPPDATA 'protectorate\download'
	New-Item -ItemType Directory -Force -Path $dir | Out-Null
	$exe = Join-Path $dir $file
	Write-Host "downloading $hub/dl/$file"
	Invoke-WebRequest -UseBasicParsing -Uri "$hub/dl/$file" -OutFile $exe
	$want = ([string](Invoke-RestMethod -UseBasicParsing -Uri "$hub/dl/$file.sha256")).Trim().Split(' ')[0].ToLowerInvariant()
	$got = (Get-FileHash -Algorithm SHA256 -LiteralPath $exe).Hash.ToLowerInvariant()
	if (-not $want -or $want -ne $got) {
		throw "SHA-256 of $exe is $got, the hub says $want`: not running it."
	}
	Write-Host "verified SHA-256 $got"
	Write-Host "installing for $env:USERDOMAIN\$env:USERNAME as a logon task: the agent runs in this user's normal, non-elevated session and needs no administrator rights"
	$argv = @('node', 'install', '--control', $control)
	if ($name) { $argv += @('--name', $name) }
	& $exe @argv
	$code = $LASTEXITCODE
	Remove-Item Env:PROTECTORATE_ENROLL_KEY -ErrorAction SilentlyContinue
	if ($code -ne 0) { throw "node install failed (exit code $code)." }
}

Install-ProtectorateNode
