#!/bin/sh
# Installs this machine as a protectorate node. Generated by the hub at
# http://hub.lan:7470; the binary comes from the same hub and is checked against
# its SHA-256 before it runs.
#
#   curl -fsSL http://hub.lan:7470/install.sh | PROTECTORATE_ENROLL_KEY=KEY sh -s -- --name NAME
#
# The key comes from Add node in the app (or `protectorate node invite` on the
# hub) and is read from the environment only. --name (or env
# PROTECTORATE_NODE_NAME) defaults to the hostname. --print-target prints the
# build this machine needs and exits. Linux x86_64 and aarch64, and Termux on
# Android aarch64.
set -eu

hub='http://hub.lan:7470'
control='http://10.0.0.5:7480'

die() {
	echo "install: $*" >&2
	exit 1
}

# target prints the build for what `uname -s`, `uname -m` and `uname -o`
# report.
target() {
	case "$1" in
	Linux) ;;
	*) die "unsupported system $1: nodes run on Linux, Windows and Android (Termux)" ;;
	esac
	os=linux
	if [ "$3" = Android ] || [ -n "${TERMUX_VERSION:-}" ]; then
		os=android
	fi
	case "$2" in
	x86_64 | amd64) arch=amd64 ;;
	aarch64 | arm64 | armv8*) arch=arm64 ;;
	*) die "unsupported architecture $2: builds exist for x86_64 and aarch64" ;;
	esac
	if [ "$os" = android ] && [ "$arch" != arm64 ]; then
		die "unsupported architecture $2 on Android: builds exist for aarch64 only"
	fi
	echo "protectorate-$os-$arch"
}

sha256() {
	if command -v sha256sum >/dev/null 2>&1; then
		sha256sum "$1" | cut -d' ' -f1
	elif command -v shasum >/dev/null 2>&1; then
		shasum -a 256 "$1" | cut -d' ' -f1
	else
		die "need sha256sum or shasum to verify the download"
	fi
}

main() {
	name=${PROTECTORATE_NODE_NAME:-}
	print=
	while [ $# -gt 0 ]; do
		case "$1" in
		--name)
			[ $# -ge 2 ] || die "--name needs a value"
			name=$2
			shift 2
			;;
		--name=*)
			name=${1#--name=}
			shift
			;;
		--print-target)
			print=1
			shift
			;;
		*) die "unknown argument $1" ;;
		esac
	done
	file=$(target "$(uname -s)" "$(uname -m)" "$(uname -o 2>/dev/null || true)")
	if [ -n "$print" ]; then
		echo "$file"
		return
	fi
	[ -n "${PROTECTORATE_ENROLL_KEY:-}" ] || die "set PROTECTORATE_ENROLL_KEY to the key from Add node in the app"
	command -v curl >/dev/null 2>&1 || die "need curl"
	dir=${XDG_CACHE_HOME:-$HOME/.cache}/protectorate
	mkdir -p "$dir"
	bin=$dir/$file
	echo "downloading $hub/dl/$file"
	curl -fsSL -o "$bin" "$hub/dl/$file"
	want=$(curl -fsSL "$hub/dl/$file.sha256" | cut -d' ' -f1)
	got=$(sha256 "$bin")
	if [ -z "$want" ] || [ "$want" != "$got" ]; then
		die "SHA-256 of $bin is $got, the hub says ${want:-nothing}: not running it"
	fi
	chmod 755 "$bin"
	echo "verified SHA-256 $got"
	if [ -n "$name" ]; then
		"$bin" node install --control "$control" --name "$name"
	else
		"$bin" node install --control "$control"
	fi
}

main "$@"
