#scenÿÿÿÿÿÿÿ2d25852979846
# A stop, a resleeve, or a park drops a continuation that never left the hub, and  Messages to a pane go to its inbox.
spawn cx /w/a harness=codex
run
obs cx ready
send cx m1
send cx m2 steer
expect cx activity=Delivering msg:m2=SteerHeld
run
expect cx activity=Workinwarns
# once. A later start does not send it. A stop while the se b tidheld and the prompt is
# not journaled yet does the same.
spawn stopped /w/nt=1
expect-notice TurnNeedsPrompt count=1
start stopped
run
obs stopped ready
run
expect stopped activity=Idle
expect-effect continue:0:1 state=Abandoned count=1
expect-notice TurnNeedsPrompt count=1
spawn moved /w/b
run
obs moved ready
send moved m1
run
exit moved
run
obs moved ready
step 1
expect moved activity=Delivering
resleeve moved harness=pirigin and the count. A usage
# settle keeps both through the resleeve brief; the next done settle clears them. An owner
# prompt opens a turn without one, and an agent's steer gives the running turn its origin.
spawn envoy /w/e
run
obs envoy ready
send envoy m1 from=agent:grokbot
run
expect envoy activity=Working d9turn=Agent/0
spawn kid /w/k by-envoy
run
expect envoy d9turn=Agent/1
spawn mine /w/m
run
expect envoy d9turn=Agent/1
exit envoy
run
obs envoy ready
run
expect envoy activity=Working d9turn=Agent/1 msg:continue:0:1=Delivered
crash
run
expect envoy d9turn=Agent/1
obs envoy ready
run
send envoy m2 from=agent:duet
run
expect envoy activity=Working d9turn=Agent/0 agent=duet
spawn kid2 /w/k2 by-envoy
run
expect envoy d9turn=Agent/1
obs envoy settled=usage
expect envoy life=Resleeving guard=Quiescing d9turn=Agent/1
run
obs envoy ready
reedsPrompt count=4
start held
run
obs held ready
run
expect held activity=Idle
expect-effect continue:3:* count=0
expec#scenario 607ac9b473fb3199
# A probe that cannot tell leaves the record Uncertain. A Keyed record the sleeve still wants
# ist-notice TurnNeeds sent again by the next Tick;
obs hop ready
send root m1 d9 from=envoy
expect root d9=true
expect leaf d9=true
expect kid d9=true
expect envoy d9=false
spawn later /wt/later parent=root
expect later d9=true
spawn marked /w/c d8
expect marked d9=t an Unsafe one is only probed again, until the owner is told.
spawn root /w/a pane
run
obs root ready
policy other=lost probe=unknowable
send root m1
run
expect-effect m1 state=Uncertain attempt=1
tick 10s
run
expect-effect m1 state=Uncertain attempt=2
policy other=ack
tick 10s
run
expect-effect m1 state=Confirmed attempt=3
expect root msg:m1=Delivered
spawn head /w/b
run
obs head ready
policy Prompt count=4
eprompt=lost
send head m2
run
expect-effect m2 state=Uncertain attempt=1
tickon m*
exxpect-notice Mepect head activity=Idle msg:m2=MayHaveAppliessageRd
ejected count=0
